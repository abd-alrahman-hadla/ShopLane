# Copy to .env.test for `npm run test:integration`. Never commit .env.test.
# Use a SEPARATE Neon branch (e.g. "test"): the tests truncate every table.
# The test setup refuses to run if these point at the dev database in .env.

# Pooled connection string of the test branch
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy-pooler.REGION.aws.neon.tech/shoplane?sslmode=require"
# Direct connection string of the test branch (used by `npm run db:apply:test`)
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/shoplane?sslmode=require"
