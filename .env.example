# Copy to .env and fill in. Never commit .env.

# Neon dev branch: pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/shoplane?sslmode=require"
# Neon dev branch: direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/shoplane?sslmode=require"

# Public base URL, used for canonical links, OG metadata and Stripe redirect URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed only: email of the admin user created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"

# Auth.js: secret for sessions and magic-link tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Needed only for `next start` outside Vercel (Vercel and `next dev` trust the host automatically).
# AUTH_TRUST_HOST="true"

# Stripe (TEST MODE ONLY outside production; live keys are rejected by src/lib/env.ts)
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_..."

# Resend. Optional in development: without it, emails and sign-in links are printed to the server console.
RESEND_API_KEY=""
# The sandbox sender only delivers to the email address of your Resend account.
EMAIL_FROM="ShopLane <onboarding@resend.dev>"

# UploadThing (admin product image uploads). Dashboard → API Keys → copy the token.
# Without it, admins can still add images by URL; uploads fail with an error message.
UPLOADTHING_TOKEN=""
