# Copy to .env and fill in. Never commit .env.

# Neon dev branch: pooled connection string (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/shoplane?sslmode=require"
# Neon dev branch: direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/shoplane?sslmode=require"

# Public base URL, used for canonical links and OG metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Seed only: email of the admin user created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
