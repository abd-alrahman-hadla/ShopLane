// ShopLane data model. All money is stored as integer cents.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & auth (Auth.js v5 Prisma adapter shape) ────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]
  auditLogs AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String   @default("US")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catalog ───────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products     Product[]
  translations CategoryTranslation[]
}

/// Category name/description in a non-default locale (English lives on Category).
model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  /// e.g. "ar". The default locale ("en") is never stored here.
  locale      String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  status         ProductStatus @default(DRAFT)
  featured       Boolean       @default(false)
  categoryId     String
  /// Denormalized from variants (see features/catalog/pricing.ts) so lists can sort by price.
  minPriceCents  Int           @default(0)
  maxPriceCents  Int           @default(0)
  /// Denormalized from reviews (see features/reviews/reviews.ts); average = ratingSum / ratingCount.
  ratingCount    Int           @default(0)
  ratingSum      Int           @default(0)
  /// Optional overrides for <title> and meta description on the product page.
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants      Variant[]
  images        ProductImage[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  translations  ProductTranslation[]

  @@index([status, categoryId])
  @@index([featured])
}

// ─── Reviews & wishlist ────────────────────────────────────────────────────

/// One review per verified buyer per product (rating 1–5, validated in Zod).
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model Variant {
  id                  String   @id @default(cuid())
  productId           String
  sku                 String   @unique
  title               String
  size                String?
  color               String?
  priceCents          Int
  compareAtPriceCents Int?
  stock               Int      @default(0)
  position            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([size])
  @@index([color])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  /// Optional: image specific to one variant (e.g. a colorway).
  variantId String?
  url       String
  alt       String
  position  Int     @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, position])
}

// ─── Cart (signed-in users; guests use the persisted Zustand store) ────────

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─── Orders & payments ─────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  CANCELLED
  REFUNDED
}

/// Product content in a non-default locale (English lives on Product). Missing fields fall back to English.
model ProductTranslation {
  id             String   @id @default(cuid())
  productId      String
  /// e.g. "ar". The default locale ("en") is never stored here.
  locale         String
  name           String
  description    String
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

model Order {
  id                      String      @id @default(cuid())
  /// Human-facing order number, displayed as SL-<number>.
  number                  Int         @unique @default(autoincrement())
  userId                  String?
  /// Null for guest orders until Stripe reports the customer's email.
  email                   String?
  status                  OrderStatus @default(PENDING)
  currency                String      @default("usd")
  /// Storefront language at checkout; emails about this order use it.
  locale                  String      @default("en")
  subtotalCents           Int
  discountCents           Int         @default(0)
  shippingCents           Int         @default(0)
  taxCents                Int         @default(0)
  totalCents              Int
  couponId                String?
  couponCode              String?
  /// Snapshot of the shipping address at purchase time.
  shippingAddress         Json?
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  /// When the Stripe Checkout Session expires.
  expiresAt               DateTime?
  paidAt                  DateTime?
  shippedAt               DateTime?
  cancelledAt             DateTime?
  /// checkout_expired | out_of_stock | payment_failed
  cancelReason            String?
  refundedAt              DateTime?
  confirmationEmailSentAt DateTime?
  fulfilledAt             DateTime?
  /// USPS | UPS | FedEx | DHL | Other
  trackingCarrier         String?
  trackingNumber          String?
  shippingEmailSentAt     DateTime?
  /// Total refunded so far (admin refunds and charge.refunded webhooks).
  refundedCents           Int         @default(0)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  variantId         String?
  // Snapshot of the product at purchase time; survives later catalog edits.
  productName       String
  variantTitle      String
  sku               String
  imageUrl          String?
  unitPriceCents    Int
  quantity          Int
  lineTotalCents    Int
  /// Units returned to stock by admin refunds (never more than quantity).
  restockedQuantity Int     @default(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  /// Percent (1–100) for PERCENTAGE, cents for FIXED_AMOUNT.
  value            Int
  minSubtotalCents Int?
  maxRedemptions   Int?
  redemptionCount  Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  orders Order[]
}

/// Processed Stripe webhook events, for idempotency.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─── Admin ─────────────────────────────────────────────────────────────────

/// One row per admin change, written in the same transaction as the change.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Snapshot, so the log stays readable if the user is deleted. "system" for scripts.
  actorEmail String
  /// e.g. product.update, order.ship, order.refund, coupon.create
  action     String
  entityType String
  entityId   String
  summary    String
  /// Field-level changes: { field: [before, after] }
  changes    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}
